import { Button, LineEdit } from "std-widgets.slint";
import { Webview } from "../src/webview/webview.slint";

export { WebviewLogic } from "../src/webview/webview.slint";
export { Palette } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Telescop";
    width: 1120px;
    height: 760px;
    background: #0d0f14;

    callback search_requested(string);
    in-out property <string> search_query: "";

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            spacing: 12px;

            Text {
                text: "Telescop";
                color: #f3f4f8;
                font-size: 26px;
                font-weight: 700;
            }
            Text {
                text: "DUCKDUCKGO IMAGES";
                color: #22d3ee;
                font-size: 11px;
                vertical-alignment: center;
            }
            Rectangle { background: transparent; }
            Text {
                text: "Navegador integrado";
                color: #8b93a5;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 1px; background: #2a3040; }

        HorizontalLayout {
            height: 48px;
            spacing: 8px;

            Button {
                text: "‹";
                width: 40px;
                clicked => { browser.back(); }
            }
            Button {
                text: "›";
                width: 40px;
                clicked => { browser.forward(); }
            }

            LineEdit {
                placeholder-text: "Pesquise imagens no DuckDuckGo...";
                text <=> root.search_query;
                accepted(text) => { root.search_requested(text); }
            }

            Button {
                text: "Pesquisar";
                clicked => { root.search_requested(root.search_query); }
            }

            Button {
                text: "↻";
                width: 42px;
                clicked => { browser.reload(); }
            }
        }

        Rectangle {
            background: #171b25;
            border-radius: 10px;
            border-width: 1px;
            border-color: #2a3040;
            vertical-stretch: 1;
            clip: true;

            browser := Webview {
                width: 100%;
                height: 100%;
            }
        }

        HorizontalLayout {
            Text {
                text: "Telescop • Página real do DuckDuckGo";
                color: #737d91;
                font-size: 11px;
            }
            Rectangle { background: transparent; }
            Text {
                text: "Servo + Slint";
                color: #737d91;
                font-size: 11px;
            }
        }
    }
}
